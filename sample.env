# Your Telegram API ID (obtain from my.telegram.org)
API_ID=1234567

# Your Telegram API Hash (obtain from my.telegram.org)
API_HASH=your_api_hash_here

# Your Telegram Bot Token (obtain from @BotFather)
BOT_TOKEN=your_bot_token_here

# Force Subscribe Channel ID (numeric ID of your Telegram channel)
# The bot must be an admin in this channel.
CHID=-1001234567890

# Sudo user IDs (space-separated list of Telegram user IDs who have admin rights for the bot)
# e.g., SUDO=123456789 987654321
SUDO=your_user_id_here

# MongoDB Connection URI (e.g., mongodb+srv://user:pass@cluster.mongodb.net/dbname)
MONGO_URI=your_mongodb_uri_here
